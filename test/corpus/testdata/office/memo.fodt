<office:body><office:text>
<text:h text:style-name="Heading_20_1" text:outline-level="1">Purpose</text:h>
<text:p text:style-name="Standard">This memo records the Q4 decisions. It has <text:span text:style-name="Bold">bold text</text:span> and <text:span text:style-name="Ital">italic text</text:span> and a footnote.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">FOOTNOTE-MARKER text.</text:p></text:note-body></text:note></text:p>
<text:h text:style-name="Heading_20_1" text:outline-level="1">Decisions</text:h>
<text:h text:style-name="Heading_20_2" text:outline-level="2">Budget</text:h>
<text:p text:style-name="Standard">Budget approved for Q1.</text:p>
<text:h text:style-name="Heading_20_2" text:outline-level="2">Hiring</text:h>
<text:p text:style-name="Standard">Two engineers will be hired.</text:p>
