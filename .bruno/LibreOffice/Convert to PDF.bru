meta {
  name: Convert to PDF
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/forms/libreoffice/convert
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../test/integration/testdata/page_1.docx)
  ~password:
  ~landscape: false
  ~paperSize: A4
  ~paperWidth: 8.27in
  ~paperHeight: 11.69in
  ~nativePageRanges:
  ~updateIndexes: false
  ~exportFormFields: true
  ~allowDuplicateFieldNames: false
  ~nativeBookmarks: true
  ~exportBookmarksToPdfDestination: false
  ~exportPlaceholders: false
  ~exportNotes: false
  ~exportNotesPages: false
  ~exportOnlyNotesPages: false
  ~exportNotesInMargin: false
  ~convertOooTargetToPdfTarget: false
  ~exportLinksRelativeFsys: false
  ~exportHiddenSlides: false
  ~skipEmptyPages: false
  ~addOriginalDocumentAsStream: false
  ~singlePage: false
  ~nativeTaggedPdf: false
  ~initialView: outline
  ~initialPage: 1
  ~magnification: fitWidth
  ~zoom: 100
  ~pageLayout: singlePage
  ~firstPageOnLeft: false
  ~resizeWindowToInitialPage: false
  ~centerWindow: false
  ~openInFullScreenMode: false
  ~displayPDFDocumentTitle: true
  ~hideViewerMenubar: false
  ~hideViewerToolbar: false
  ~hideViewerWindowControls: false
  ~useTransitionEffects: true
  ~openBookmarkLevels: -1
  ~nativeLosslessImageCompression: false
  ~nativeQuality: 90
  ~nativeReduceImageResolution: false
  ~nativeMaxImageResolution: 300
  ~nativeWatermarkText:
  ~nativeWatermarkColor: #ff0000
  ~nativeWatermarkFontSize: 48
  ~nativeWatermarkRotation: 45
  ~nativeWatermarkFont: Helvetica
  ~nativeTiledWatermarkText:
  ~nativePdfa: PDF/A-2b
  ~nativePdfua: PDF/UA-1
  ~stages: [{"op":"set-metadata","title":"My title"},{"op":"remediate","profile":"PDF/A-2b"},{"op":"render","pages":"1"}]
}

headers {
  ~Gotenberg-Output-Filename: my-file
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
