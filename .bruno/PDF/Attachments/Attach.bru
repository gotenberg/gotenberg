meta {
  name: Attach
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/forms/pdf/attach
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../../test/integration/testdata/page_1.pdf)
  file: embed_1.xml
  files: @file(../../test/integration/testdata/embed_1.xml)
  ~name: invoice.xml
  ~mimeType: text/xml
  ~relationship: Data
}

headers {
  ~Gotenberg-Output-Filename: attached
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Error-Url: http://localhost:8080/webhook/error
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Error-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
