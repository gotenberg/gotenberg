meta {
  name: Extract Attachments
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/forms/pdf/extract-attachments
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../test/integration/testdata/page_1_with_attachment.pdf)
  ~name: embed_1.xml
}

headers {
  ~Gotenberg-Output-Filename: extracted
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
