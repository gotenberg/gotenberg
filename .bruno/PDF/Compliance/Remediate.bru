meta {
  name: Remediate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/forms/pdf/remediate
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../test/integration/testdata/page_1.pdf)
  profile: PDF/A-2b
  ~profile: PDF/UA-1
  ~language: en-US
  ~aggressive: true
  ~figureAltText: A chart
  ~xml: embed_1.xml
  ~files: @file(../test/integration/testdata/embed_1.xml)
  ~level: EN 16931
  ~documentType:
}

headers {
  ~Gotenberg-Output-Filename: remediated
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}

docs {
  `xml`, `files` (the invoice XML), `level` and `documentType` apply to the `Factur-X` profile only: set `profile` to `Factur-X` before enabling them.

  Enable the second `profile` to remediate to a PDF/A profile and a PDF/UA one together. PDF/A-1, PDF/A-2 and PDF/A-3 profiles and `Factur-X` pair with `PDF/UA-1`, PDF/A-4 profiles with `PDF/UA-2`; any other pair answers 400.
}
