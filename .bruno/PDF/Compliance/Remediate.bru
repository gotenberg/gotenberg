meta {
  name: Remediate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/forms/pdf/remediate
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../../test/integration/testdata/page_1.pdf)
  profile: PDF/A-2b
  ~language: en-US
  ~xml: embed_1.xml
  ~files: @file(../../test/integration/testdata/embed_1.xml)
  ~level: EN 16931
  ~documentType:
}

headers {
  ~Gotenberg-Output-Filename: remediated
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
