meta {
  name: Select
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/forms/pdf/select
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../../test/integration/testdata/pages_12.pdf)
  pages: 1-3,last
}

headers {
  ~Gotenberg-Output-Filename: selected
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Error-Url: http://localhost:8080/webhook/error
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Error-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
