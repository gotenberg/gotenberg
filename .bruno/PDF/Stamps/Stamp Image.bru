meta {
  name: Stamp Image
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/forms/pdf/stamp-image
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../../test/integration/testdata/page_1.pdf)
  image: watermark.png
  files: @file(../../test/integration/testdata/watermark.png)
  ~pages:
  ~x: 72
  ~y: 72
  ~width: 100
  ~height: 100
  ~opacity: 0.5
  ~rotation: 0
}

headers {
  ~Gotenberg-Output-Filename: stamped
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
