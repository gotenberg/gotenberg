meta {
  name: Sign
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/forms/pdf/sign
  body: multipartForm
  auth: none
}

body:multipart-form {
  files: @file(../../test/integration/testdata/page_1.pdf)
  certificate: cert.pem
  files: @file(../../test/integration/testdata/pem/cert.pem)
  key: key.pem
  files: @file(../../test/integration/testdata/pem/key.pem)
  ~password:
  ~reason: Approved
  ~location: Paris
  ~contactInfo:
  ~name:
  ~pades: false
  ~timestampUrl: https://freetsa.org/tsr
}

headers {
  ~Gotenberg-Output-Filename: signed
  ~Gotenberg-Webhook-Url: http://localhost:8080/webhook
  ~Gotenberg-Webhook-Events-Url: http://localhost:8080/webhook/events
  ~Gotenberg-Webhook-Method: POST
  ~Gotenberg-Webhook-Extra-Http-Headers: {"X-Custom":"value"}
}
